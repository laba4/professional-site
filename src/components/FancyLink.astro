---
import type { HTMLAttributes } from 'astro/types';
import Link from '@/components/Link.astro';
import ArrowBox from '@/components/icons/ArrowBox.astro';

type Props = HTMLAttributes<'a'>;

const { href, ...rest } = Astro.props;
const isExternal = /^https?:\/\//.test(String(href ?? ''));
---

<Link
  href={href}
  class="link link-warning inline-flex items-center gap-1"
  {...rest}
>
  <slot />
  {isExternal && <ArrowBox />}
</Link>
