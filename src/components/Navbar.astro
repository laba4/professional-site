---
const links = [
  { href: '/posts', label: 'Posts' },
  { href: '/uses', label: 'Uses' },
  { href: '/books', label: 'Books' },
  { href: '/credentials', label: 'Credentials' },
];

const isActive = (href: string) => Astro.url.pathname.startsWith(href);
---

<div class="drawer z-100">
  <input id="my-drawer-2" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content flex flex-col">
    <nav class="navbar bg-base-100 max-w-7xl mx-auto">
      <div class="flex-none lg:hidden">
        <label
          for="my-drawer-2"
          aria-label="open sidebar"
          class="btn btn-square btn-ghost"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            class="inline-block h-6 w-6 stroke-current"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
        </label>
      </div>
      <div class="flex-1">
        <a href="/" class="ml-4 text-3xl font-bold -tracking-widest">
          LB
        </a>
      </div>
      <div class="hidden flex-none lg:block">
        <ul class="menu menu-horizontal gap-1 px-1">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={{
                  'bg-base-content/10 text-base-content': isActive(href),
                }}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
  <div class="drawer-side">
    <label
      for="my-drawer-2"
      aria-label="close sidebar"
      class="drawer-overlay"
    ></label>
    <ul class="menu gap-1 bg-base-200 min-h-full w-80 p-4">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={{
              'bg-base-content/10 text-base-content': isActive(href),
            }}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
