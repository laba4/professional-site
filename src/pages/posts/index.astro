---
import { getCollection } from 'astro:content';
import ProseLayout from '@/layouts/ProseLayout.astro';
import Link from '@/components/FancyLink.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<ProseLayout
  title="Posts"
  description="Technical write-ups and insights into my professional journey."
>
  <h1>Posts</h1>
  {posts.length > 0 ? (
    <>
      <p>My posts, sorted by publish date</p>
      <ul>
        {posts.map((post) => (
          <li>
            <Link href={`/posts/${post.id}`}>{post.data.title}</Link>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <p>There are no posts to read yet. Come back later.</p>
  )}
</ProseLayout>
